# Dynamic-linked nim test-node, for the Shadow simulator.
#
# Mirrors Dockerfile_amd64 but DROPS the static linker flags
# (`--passL:"-static -mmusl"` and `--passL:"-static-libgcc -static-libstdc++"`).
#
# Why: Shadow's syscall interposer is LD_PRELOAD-based and only hooks
# dynamically linked ELFs. A statically linked nim binary fails at startup with
# "Failed to verify plugin path '...': not a dynamically linked ELF".
#
# Build via kaniko on a lab worker (see shadow/kaniko-build-test-node-job.yaml).
# Pushes to radiken/dst-test-node-shadow:latest.

FROM nimlang/nim:2.2.10 AS builder

ARG NODE_BINARY=node

WORKDIR /node

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl git build-essential ca-certificates \
    libssl3 iproute2 procps \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

RUN git config --global http.sslVerify false && git config --global http.version HTTP/1.1

# Newer nimble: the bundled one cannot read nim-boringssl tags and drops the whole range.
RUN nimble install -y 'nimble@#07caee397d628c9e93d81048268365c4c2414a80'
ENV PATH="/root/.nimble/bin:${PATH}"
RUN nim --version && nimble --version

COPY . .

RUN nimble refresh
RUN nimble install -dy --verbose --useSystemNim

# Floor lsquic's engine tick re-arms so Shadow can advance simulated time.
# Gated by LSQUIC_TICK_FLOOR_US (unset/0 = stock). See README.md.
COPY lsquic-tick-floor.patch /tmp/lsquic-tick-floor.patch
RUN set -eu; \
    patched=0; \
    for d in /root/.nimble/pkgcache/*lsquic*/ /root/.nimble/pkgs2/lsquic-*/; do \
      [ -f "${d}lsquic/context/context.nim" ] || continue; \
      if grep -q tickFloorUs "${d}lsquic/context/context.nim"; then echo "already patched $d"; continue; fi; \
      ( cd "$d" && git apply -p1 /tmp/lsquic-tick-floor.patch ); \
      echo "patched $d"; patched=$((patched+1)); \
    done; \
    [ "$patched" -gt 0 ] || { echo "no lsquic package found to patch"; exit 1; }

# Dynamic link: no `-static`, no `-mmusl`, no `-static-libgcc/-libstdc++`.
RUN nimble c --useSystemNim \
    --os:linux --cpu:amd64 \
    -d:chronicles_colors=None --threads:on --mm:refc \
    -d:metrics -d:libp2p_network_protocols_metrics -d:release \
    main \
    && chmod +x /node/main \
    && (grep -l tickFloorUs /root/.nimble/pkgs2/lsquic-*/lsquic/context/context.nim \
        || echo "patch WIPED by nimble re-resolve") \
    && grep -qa LSQUIC_TICK_FLOOR_US /node/main \
    && echo "TICK-FLOOR VERIFIED IN BINARY"

# Tiny final stage: the binary + its runtime deps. The image's role is to hand
# off /node/main to an init container, not to run anything itself. We still
# include glibc/libssl/libstdc++ in case someone wants to `docker run` it.
FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    libssl3 libgcc-s1 libstdc++6 ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

COPY --from=builder /node/main /node/main

ENTRYPOINT ["/node/main"]
