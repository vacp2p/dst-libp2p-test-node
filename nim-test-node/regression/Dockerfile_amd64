# syntax=docker/dockerfile:1
FROM nimlang/nim:2.2.10 AS builder

WORKDIR /node

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl git build-essential ca-certificates \
    libssl3 iproute2 procps \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

RUN git config --global http.sslVerify false && git config --global http.version HTTP/1.1

# Newer nimble: the bundled one cannot read nim-boringssl tags and drops the whole range.
RUN nimble install -y 'nimble@#07caee397d628c9e93d81048268365c4c2414a80'
ENV PATH="/root/.nimble/bin:${PATH}"
RUN nim --version && nimble --version
RUN nimble refresh

# Install deps from the .nimble only, so a source-only change (main.nim, etc.) does
# not invalidate this layer and re-fetch nim-libp2p.
COPY test_node.nimble .
RUN nimble install -dy --verbose --useSystemNim | tee /tmp/install.log && grep -A 20 "libp2p" /tmp/install.log | grep -oP '\b\d+\.\d+\.\d+\b' | head -n1 > ./libp2p_version

# Now the source. The nimcache is a persistent build cache, so unchanged modules
# (all of nim-libp2p, on a code-only change) aren't recompiled.
COPY . .
RUN --mount=type=cache,target=/root/.cache/nim nimble c --useSystemNim \
    --os:linux --cpu:amd64 --passL:"-static -mmusl" \
    -d:chronicles_colors=None --threads:on --mm:refc \
    -d:metrics -d:libp2p_network_protocols_metrics -d:release \
    -d:chronosFutureTracking --hints:on \
    --passL:"-static-libgcc -static-libstdc++" \
    main


RUN chmod +x /node/main
RUN nim --version > nim_version
RUN nimble --version > nimble_version

EXPOSE 5000 8008 8645

ENTRYPOINT ["/node/main"]
